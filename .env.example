# Copia este archivo como .env y cambia los valores.
#     cp .env.example .env

# MySQL 8. Pon USAR_SQLITE=True para trabajar solo con el archivo local.
USAR_SQLITE=False
DB_NAME=facturas
DB_USER=facturacion
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306

# Genera una clave larga para produccion, por ejemplo con:
#     python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
